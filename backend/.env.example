#Database configuration (PostgreSQL)
DB_NAME=company_knowledge_ai
DB_USER=company_knowledge_ai
DB_PASSWORD=your_db_password_here
DB_HOST=127.0.0.1
DB_PORT=5432
# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
# Auth0 (ID-token flow) — tenant domain without scheme, e.g. dev-abc123.us.auth0.com
AUTH0_DOMAIN=your-tenant.us.auth0.com
# Auth0 Application Client ID (the `aud` of its ID tokens)
AUTH0_AUDIENCE=your-auth0-client-id