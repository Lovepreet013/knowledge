# ==============================
# Environment & secrets — NEVER commit these
# ==============================
.env
.env.local
.env.*.local
backend/.env

# ==============================
# Python / Django (backend)
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
virtual-env/
venv/
env/
ENV/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Media & static files (user-uploaded documents — don't commit real user data)
backend/media/
media/
staticfiles/
static_root/

# Migrations — commit these normally, this is just here as a reminder NOT to add an exclude rule for them
# (intentionally left uncommented — migrations SHOULD be tracked)

# Celery
celerybeat-schedule
celerybeat.pid

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Testing / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/

# Type checking / linting caches
.mypy_cache/
.ruff_cache/

# ==============================
# Node / React (frontend) — Bun
# ==============================
node_modules/
frontend/node_modules/
frontend/dist/
dist/
build/

# Vite
.vite/

# Bun
bun.lockb
.bun/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# Package manager lock files — uncomment ONE of these if you want to exclude it
# (generally you SHOULD commit lock files — left here only as a reference, not enabled)
# package-lock.json
# yarn.lock
# bun.lock

# ==============================
# Editor / OS
# ==============================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==============================
# Misc
# ==============================
*.pyc
*.bak
*.tmp